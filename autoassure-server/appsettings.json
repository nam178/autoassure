{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "https://app.autoassure.ai/auth/callback"
    }
  },
  "Cors": {
    "AllowedOrigins": ["https://app.autoassure.ai"]
  },
  "Auth": {
    "SigningKey": "",
    "Issuer": "autoassure-server",
    "Audience": "autoassure-web",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 30
  },
  "DynamoDb": {
    "RefreshTokenTableName": "prod-autoassure-refresh-token-table"
  }
}
