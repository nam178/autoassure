root = true

[*.cs]
max_line_length = 80
# XML doc settings: https://www.jetbrains.com/help/resharper/EditorConfig_XMLDOC_XmlDocCodeStylePageSchema.html
resharper_xmldoc_indent_text = ZeroIndent
resharper_xmldoc_max_line_length = 80

[*.md]
max_line_length = 80
ij_markdown_wrap_text_if_long = true
ij_markdown_wrap_text_inside_blockquotes = true