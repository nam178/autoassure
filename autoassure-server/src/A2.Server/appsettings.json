{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "https://app.autoassure.ai/auth/callback"
    }
  },
  "Cors": {
    "AllowedOrigins": ["https://app.autoassure.ai"]
  },
  "Auth": {
