    "OrganizationUserTableName": "prod-autoassure-organization-user-table",
    "ApplicationTableName": "prod-autoassure-application-table",
    "EnvironmentTableName": "prod-autoassure-environment-table",
    "EnvironmentVariableTableName": "prod-autoassure-environment-variable-table",
    "PreconditionTableName": "prod-autoassure-precondition-table",
    "EvidenceDefinitionTableName": "prod-autoassure-evidence-definition-table",
    "ScenarioTableName": "prod-autoassure-scenario-table",
    "ScenariosByFolderTableName": "prod-autoassure-scenarios-by-folder-table",
    "ScenariosByTagTableName": "prod-autoassure-scenarios-by-tag-table",
    "RunTableName": "prod-autoassure-run-table",
    "TryTableName": "prod-autoassure-try-table"
