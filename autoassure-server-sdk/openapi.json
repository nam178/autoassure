{
  "openapi": "3.1.1",
  "info": {
    "title": "A2.Server | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/google/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeGoogleCodeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeGoogleCodeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeGoogleCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthTokenResponse": {
        "required": [
          "token",
          "expiresInSeconds",
          "refreshTokenSecret",
          "user"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresInSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of seconds until Token expires, measured from when the response is sent.\nA relative duration is used instead of an absolute timestamp because the client's clock may be offset\nfrom the server's.",
            "format": "int32"
          },
          "refreshTokenSecret": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "description": "Returned after a successful Google sign-in: the issued tokens and the signed-in user."
      },
      "ExchangeGoogleCodeRequest": {
        "required": [
          "code",
          "codeVerifier"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "The authorization code returned by Google after the user consents."
          },
          "codeVerifier": {
            "type": "string",
            "description": "The PKCE code verifier the client generated for this authorization request."
          }
        },
        "description": "An OAuth 2.0 PKCE authorization code from Google's consent screen, to be exchanged for\n    the user's Google identity."
      },
      "RefreshTokenRequest": {
        "required": [
          "refreshTokenSecret"
        ],
        "type": "object",
        "properties": {
          "refreshTokenSecret": {
            "type": "string",
            "description": "The raw refresh token secret previously issued to the client, to be exchanged for a new access token."
          }
        },
        "description": "Requests a new access token using a previously issued refresh token."
      },
      "RefreshTokenResponse": {
        "required": [
          "token",
          "expiresInSeconds",
          "refreshTokenSecret"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresInSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of seconds until Token expires, measured from when the response is sent.\nA relative duration is used instead of an absolute timestamp because the client's clock may be offset\nfrom the server's.",
            "format": "int32"
          },
          "refreshTokenSecret": {
            "type": "string"
          }
        },
        "description": "Returned after a successful token refresh: the newly issued tokens."
      },
      "UserResponse": {
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "emailVerified"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean"
          }
        },
        "description": "The signed-in AutoAssure user, as returned to the client after authentication."
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    }
  ]
}