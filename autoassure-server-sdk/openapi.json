{
  "openapi": "3.1.1",
  "info": {
    "title": "A2.Server | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/auth/google/token": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeGoogleCodeRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeGoogleCodeRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ExchangeGoogleCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshTokenResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthTokenResponse": {
        "required": [
          "token",
          "expiresInSeconds",
          "refreshTokenSecret",
          "identity"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresInSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of seconds until Token expires, measured from when the response is sent.\nA relative duration is used instead of an absolute timestamp because the client's clock may be offset\nfrom the server's.",
            "format": "int32"
          },
          "refreshTokenSecret": {
            "type": "string"
          },
          "identity": {
            "$ref": "#/components/schemas/GoogleIdentity"
          }
        }
      },
      "ExchangeGoogleCodeRequest": {
        "required": [
          "code",
          "codeVerifier"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "codeVerifier": {
            "type": "string"
          }
        }
      },
      "GoogleIdentity": {
        "required": [
          "googleUserId",
          "email",
          "emailVerified",
          "name",
          "hostedDomain"
        ],
        "type": "object",
        "properties": {
          "googleUserId": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "emailVerified": {
            "type": "boolean",
            "description": "True if Google confirmed the email. Only trust this when string? GoogleIdentity.HostedDomain is set\n(a Google Workspace account, verified by the domain admin) or string GoogleIdentity.Email ends with\n\"@gmail.com\" (Google-owned, self-verified). For any other domain the address may belong to a\nnon-Google mailbox that was never actually confirmed to receive mail — don't rely on it."
          },
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "hostedDomain": {
            "type": [
              "null",
              "string"
            ],
            "description": "The Google Workspace domain (\"hd\" claim), or null for a personal account."
          }
        }
      },
      "RefreshTokenRequest": {
        "required": [
          "refreshTokenSecret"
        ],
        "type": "object",
        "properties": {
          "refreshTokenSecret": {
            "type": "string",
            "description": "The raw refresh token secret previously issued to the client, to be exchanged for a new access token."
          }
        }
      },
      "RefreshTokenResponse": {
        "required": [
          "token",
          "expiresInSeconds",
          "refreshTokenSecret"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresInSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of seconds until Token expires, measured from when the response is sent.\nA relative duration is used instead of an absolute timestamp because the client's clock may be offset\nfrom the server's.",
            "format": "int32"
          },
          "refreshTokenSecret": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Auth"
    }
  ]
}